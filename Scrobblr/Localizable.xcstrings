      "shouldTranslate": false
    },
    "A track scrobbles once you've listened to this much of it, or after the maximum time — whichever comes first. Tracks shorter than the minimum are never scrobbled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una canción se scrobblea cuando has escuchado esta parte de ella, o tras el tiempo máximo, lo que ocurra primero. Las canciones más cortas que el mínimo nunca se scrobblean."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un titre est scrobblé dès que vous en avez écouté cette proportion, ou après la durée maximale, selon ce qui arrive en premier. Les titres plus courts que le minimum ne sont jamais scrobblés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma faixa é scrobblada quando você ouve esta parte dela ou após o tempo máximo, o que ocorrer primeiro. Faixas mais curtas que o mínimo nunca são scrobbladas."
          }
        }
      }
    },
    "A track scrobbles once you've listened to this much of it. Last.fm's default is 50%.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una canción se scrobblea cuando has escuchado esta parte de ella. El valor predeterminado de Last.fm es 50%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un titre est scrobblé dès que vous en avez écouté cette proportion. La valeur par défaut de Last.fm est de 50 %."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma faixa é scrobblada quando você ouve esta parte dela. O padrão do Last.fm é 50%."
          }
        }
      }
    },
